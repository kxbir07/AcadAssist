  "components": {
    "schemas": {
      "ActionItem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Action category (e.g. quiz_generated, plan_updated)"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Human-readable description of the action"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload",
            "description": "Action-specific structured data"
          }
        },
        "type": "object",
        "required": [
          "type",
          "description"
        ],
        "title": "ActionItem",
        "description": "Structured action generated during tool execution (e.g. quiz ready, study plan created)."
      },
      "ChatRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "UUID of the student user"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message",
            "description": "Student's prompt or question"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "message"
        ],
        "title": "ChatRequest",
        "description": "Request payload sent from React to POST /api/chat."
      },
      "ChatResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Agent's grounded response to the student"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceItem"
            },
            "type": "array",
            "title": "Sources",
            "description": "Preserved citations from retrieved knowledge"
          },
          "actions": {
            "items": {
              "$ref": "#/components/schemas/ActionItem"
            },
            "type": "array",
            "title": "Actions",
            "description": "Follow-up actions or structured tool results"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatResponse",
        "description": "Response payload returned from POST /api/chat to React."
      },
      "ChunkResult": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id",
            "description": "UUID of the chunk"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id",
            "description": "UUID of the source document"
          },
          "course_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Course Id",
            "description": "UUID of the course"
          },
          "subject_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject Id",
            "description": "UUID of the subject"
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Text content of the retrieved chunk"
          },
          "document_title": {
            "type": "string",
            "title": "Document Title",
            "description": "Title of the source document"
          },
          "section_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section Title",
            "description": "Section or chapter title"
          },
          "filename": {
            "type": "string",
            "title": "Filename",
            "description": "Original filename of the document"
          },
          "page_number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Number",
            "description": "Page number if applicable"
          },
          "slide_number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slide Number",
            "description": "Slide number if applicable"
          },
          "score": {
            "type": "number",
            "title": "Score",
            "description": "Retrieval similarity score"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "document_id",
          "content",
          "document_title",
          "filename",
          "score"
        ],
        "title": "ChunkResult",
        "description": "Single retrieved knowledge base chunk."
      },
