# AcadAssist Unified Environment Configuration (Example)
# Copy this file to .env and configure local or cloud settings.
# NEVER commit real credentials or secrets to version control.

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=change_this_to_a_secure_random_32_byte_secret_in_production

# Database Configuration (Default: local SQLite database)
DATABASE_URL=sqlite:///./data/acadassist.db

# Azure Identity & Storage Configuration (Person 1 & Person 2)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=study-materials
STORAGE_LOCAL_DIR=./data/storage

# Azure AI Search Configuration (Person 1 & Person 2 Knowledge Hybrid Search)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=acadassist-index
AZURE_SEARCH_INDEX=acadassist-index

# Microsoft Foundry & Agent Configuration (Person 1)
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_PROJECT=acadassist-foundry
FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1-mini
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small
FOUNDRY_AGENT_NAME=AcadAssist

# Embedding Model Configuration (Person 2 / Azure OpenAI or OpenAI)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Assessment Subsystem Configuration (Person 3)
ADAPTIVE_EASY_THRESHOLD=50.0
ADAPTIVE_HARD_THRESHOLD=75.0
DEFAULT_DIFFICULTY=medium
WEAK_TOPIC_THRESHOLD=0.60
STRONG_TOPIC_THRESHOLD=0.75

# Exam Proximity Windows (in days - Person 3 & Person 4)
EXAM_NORMAL_DAYS=14
EXAM_INCREASED_DAYS=7
EXAM_WEAK_TOPIC_DAYS=3
EXAM_REVISION_DAYS=2

# Study Intelligence Defaults (Person 4)
DEFAULT_STUDY_TIME_MINUTES=120
STRONG_MASTERY_THRESHOLD=75.0
WEAK_MASTERY_THRESHOLD=60.0
MASTERY_COMPLETION_THRESHOLD=70.0
